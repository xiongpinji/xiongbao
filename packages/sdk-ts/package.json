{
  "name": "@xagent/sdk-ts",
  "version": "0.1.0",
  "description": "X-Agent TypeScript SDK",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/client.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0"
}
