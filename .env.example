# XAgent 环境变量示例
# 复制为 .env 并填入真实 key 后使用；.env 不会进 git。
# 所有 key 仅从环境变量读取，代码中无任何硬编码 key。

# ============================================================================
# LLM（剧本生成 / 智能体调度）—— DeepSeek 直连
# ============================================================================
XAGENT_LLM__DEFAULT_MODEL=deepseek-v4-flash
XAGENT_LLM__DEEPSEEK_API_KEY=sk-替换为你的key
# 可选：DeepSeek base url（litellm 默认 https://api.deepseek.com，无需改）
# XAGENT_LLM__OPENAI_API_KEY=sk-如果走 openai 直连
# XAGENT_LLM__PROXY_URL=http://localhost:4000   # 走 LiteLLM Proxy 时填

# ============================================================================
# 图像生成（关键帧）—— 中转站 OpenAI 兼容（gpt-image-2）
# ============================================================================
XAGENT_MEDIA__DEFAULT_IMAGE_PROVIDER=openai
XAGENT_MEDIA__OPENAI_IMAGE_API_KEY=sk-替换为你的key
XAGENT_MEDIA__OPENAI_IMAGE_BASE_URL=https://yunqiaoapi.com/v1
XAGENT_MEDIA__OPENAI_IMAGE_MODEL=gpt-image-2

# ============================================================================
# 视频生成 —— 火山方舟 VolcanoArk（豆包 Seedance 2.0）
# ============================================================================
XAGENT_MEDIA__DEFAULT_VIDEO_PROVIDER=volcano_ark
XAGENT_MEDIA__VOLCANO_ARK_API_KEY=ark-替换为你的key
XAGENT_MEDIA__VOLCANO_ARK_BASE_URL=https://ark.cn-beijing.volces.com
XAGENT_MEDIA__VOLCANO_ARK_MODEL=doubao-seedance-2-0-260128

# ============================================================================
# 可选：其他视频 provider（留空即不启用）
# ============================================================================
# XAGENT_MEDIA__DEFAULT_VIDEO_PROVIDER=kling
# XAGENT_MEDIA__KLING_API_KEY=
# XAGENT_MEDIA__KLING_SUBMIT_URL=
# XAGENT_MEDIA__KLING_POLL_URL=

# XAGENT_MEDIA__DEFAULT_VIDEO_PROVIDER=jimeng
# XAGENT_MEDIA__JIMENG_API_KEY=
# XAGENT_MEDIA__JIMENG_SUBMIT_URL=
# XAGENT_MEDIA__JIMENG_POLL_URL=
