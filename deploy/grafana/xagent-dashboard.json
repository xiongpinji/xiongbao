{
  "annotations": { "list": [] },
  "editable": true,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["xagent"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "X-Agent Overview",
  "uid": "xagent-overview",
  "panels": [
    {
      "id": 1,
      "title": "QPS (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(xagent_http_requests_total[1m])", "legendFormat": "{{method}} {{path}}" }
      ]
    },
    {
      "id": 2,
      "title": "P95 / P99 Latency (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(xagent_http_request_duration_seconds_bucket[5m]))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, rate(xagent_http_request_duration_seconds_bucket[5m]))", "legendFormat": "P99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "title": "Active Connections",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        { "expr": "xagent_active_connections", "legendFormat": "active" }
      ]
    },
    {
      "id": 4,
      "title": "LLM Calls (rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 8 },
      "targets": [
        { "expr": "rate(xagent_llm_calls_total[5m])", "legendFormat": "{{model}} {{status}}" }
      ]
    },
    {
      "id": 5,
      "title": "Error Rate (5xx)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "rate(xagent_http_requests_total{status=~\"5..\"}[5m]) / rate(xagent_http_requests_total[5m])", "legendFormat": "5xx ratio" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "steps": [{"color":"green","value":null},{"color":"red","value":0.05}] }
        }
      }
    },
    {
      "id": 6,
      "title": "MCP Tool Calls",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "rate(xagent_mcp_tool_calls_total[5m])", "legendFormat": "{{server}}/{{tool}}" }
      ]
    },
    {
      "id": 7,
      "title": "Agent 运行速率 (runs/min)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "rate(xagent_agent_runs_total[1m]) * 60", "legendFormat": "{{role}}" }
      ]
    },
    {
      "id": 8,
      "title": "Agent 运行耗时 P95 (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(xagent_agent_run_seconds_bucket[5m]))", "legendFormat": "{{role}} p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 9,
      "title": "429 限流 / 402 配额",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 32 },
      "targets": [
        { "expr": "xagent_http_requests_total{status=\"429\"}", "legendFormat": "429" },
        { "expr": "xagent_http_requests_total{status=\"402\"}", "legendFormat": "402" }
      ]
    }
  ]
}
