# ============ X-Agent full 模式环境变量 ============
# 复制为 .env 后按需填写。lite 模式可全部留空（走降级实现）。

XAGENT_MODE=full
XAGENT_DEBUG=false
# 生产禁止 "*"；当前 Compose 基线前端地址为 3300
XAGENT_CORS_ORIGINS=["http://localhost:3300"]

# ---- 数据库（Postgres）----
XAGENT_DB__URL=postgresql+asyncpg://xagent:xagent@postgres:5432/xagent

# ---- 缓存（Redis）----
XAGENT_CACHE__REDIS_URL=redis://redis:6379/0

# ---- LLM 网关（三选一：proxy / ollama / 直连）----
# 通用建议：冷启动较慢的本地模型把请求超时调到 150s，并在 API/worker 启动前做一次最小 warmup。
XAGENT_LLM__REQUEST_TIMEOUT_SECONDS=150
XAGENT_LLM__WARMUP_ENABLED=true
# 预热提示词建议尽量短，减少首次加载耗时；下面配置要求模型只回复一个字。
XAGENT_LLM__WARMUP_PROMPT=回复一个字：好
XAGENT_LLM__WARMUP_MAX_TOKENS=8
# 对 qwen2.5vl:7b 这类冷启动较慢的本地模型，预热最多等待 120 秒；每 1 秒轮询一次。
XAGENT_LLM__WARMUP_WAIT_TIMEOUT_SECONDS=120
XAGENT_LLM__WARMUP_POLL_INTERVAL_SECONDS=1

# 方式1: LiteLLM Proxy（provider key 配在 litellm config.yaml）
# XAGENT_LLM__PROXY_URL=http://litellm:4000
# XAGENT_LLM__PROXY_API_KEY=sk-xagent-local

# 方式2: 本地 Ollama（零费用本地推理，推荐本地开发/演示）
# 冷启动 rehearsal 基线见 .env.rehearsal（qwen2.5vl:7b）；若继续使用本示例默认值，请先 ollama pull qwen3:4b，然后：
XAGENT_LLM__OLLAMA_BASE_URL=http://host.docker.internal:11434
XAGENT_LLM__OLLAMA_MODEL=qwen3:4b
XAGENT_LLM__DEFAULT_MODEL=qwen3:4b

# 方式3: 直连 provider（不经 proxy）
# XAGENT_LLM__OPENAI_API_KEY=
# XAGENT_LLM__DEEPSEEK_API_KEY=

# ---- 向量库（Qdrant）----
XAGENT_MEMORY__QDRANT_URL=http://qdrant:6333
XAGENT_MEMORY__COLLECTION=xagent_memory
XAGENT_MEMORY__EMBEDDING_MODEL=text-embedding-3-small
XAGENT_MEMORY__EMBEDDING_DIM=1536

# ---- 可观测（Langfuse）----
XAGENT_OBSERVABILITY__LANGFUSE_HOST=http://langfuse:3000
XAGENT_OBSERVABILITY__LANGFUSE_PUBLIC_KEY=
XAGENT_OBSERVABILITY__LANGFUSE_SECRET_KEY=

# ---- 安全（生产必填；复制后必须填写真实随机值，否则 compose 拒绝启动）----
XAGENT_SECURITY__JWT_SECRET=
XAGENT_SECURITY__REQUIRE_AUTH=true

# ---- Langfuse secrets（生产必填；复制后必须填写真实随机值）----
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_INIT_USER_PASSWORD=

# ---- 媒体生成（短剧工厂，多模型可插拔）----
# 图像：gpt-image-2 / dall-e-3（OpenAI 兼容）
# XAGENT_MEDIA__DEFAULT_IMAGE_PROVIDER=openai
# XAGENT_MEDIA__OPENAI_IMAGE_API_KEY=
# XAGENT_MEDIA__OPENAI_IMAGE_MODEL=gpt-image-2
# 视频：可灵 Kling / 即梦 Jimeng / 通用任务式
# XAGENT_MEDIA__DEFAULT_VIDEO_PROVIDER=kling
# XAGENT_MEDIA__KLING_API_KEY=
# XAGENT_MEDIA__KLING_SUBMIT_URL=
# XAGENT_MEDIA__KLING_POLL_URL=.../{task_id}
# 详见 docs/CREATIVE_STUDIO_MEDIA.md

# ============ 基础设施服务自身的账号（compose 用）============
POSTGRES_USER=xagent
POSTGRES_PASSWORD=xagent
POSTGRES_DB=xagent
