# X-Agent 环境配置 — Staging（预发布）
# 用法: cp .env.staging .env && docker compose up

XAGENT_MODE=full
XAGENT_DEBUG=false

# 数据库（独立 staging 库）
XAGENT_DB__URL=postgresql+asyncpg://xagent:xagent@postgres:5432/xagent_staging

# Redis
XAGENT_CACHE__REDIS_URL=redis://redis:6379/1

# Qdrant
XAGENT_MEMORY__QDRANT_URL=http://qdrant:6333

# LLM（staging 用较小模型节省成本）
XAGENT_LLM__DEFAULT_MODEL=qwen3:4b
XAGENT_LLM__REQUEST_TIMEOUT_SECONDS=120

# 安全
XAGENT_SECURITY__JWT_SECRET=staging-secret-change-me
XAGENT_SECURITY__REQUIRE_AUTH=true

# CORS
XAGENT_CORS_ORIGINS=["http://localhost:3000","https://staging.xagent.dev"]

# 可观测性
XAGENT_OBSERVABILITY__LANGFUSE_HOST=http://langfuse:3000

# 限流（staging 宽松）
XAGENT_RATE_LIMIT__MAX_REQUESTS=500
XAGENT_RATE_LIMIT__WINDOW_SECONDS=60
